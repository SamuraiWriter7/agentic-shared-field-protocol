{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kazene:agentic-shared-field-protocol:shared-field-profile:0.5.0",
  "title": "Agentic Shared Field Profile",
  "description": "Defines a selectively permeable shared field for autonomous agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "field_id",
    "name",
    "field_kind",
    "origin",
    "governance",
    "resource_domains",
    "access_policy",
    "permeability_policy",
    "contribution_policy",
    "reuse_policy",
    "immune_policy",
    "retention_policy",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "shared-field-profile"
    },
    "field_id": {
      "type": "string",
      "pattern": "^field:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "field_kind": {
      "type": "string",
      "enum": [
        "knowledge",
        "memory",
        "reasoning",
        "compute",
        "value",
        "composite"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "created_by",
        "created_at"
      ],
      "properties": {
        "origin_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "created_by": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance_mode",
        "policy_ref",
        "steward_ids"
      ],
      "properties": {
        "governance_mode": {
          "type": "string",
          "enum": [
            "stewarded",
            "federated",
            "rule-bound"
          ]
        },
        "policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "steward_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "uniqueItems": true
        }
      }
    },
    "resource_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "knowledge",
          "memory",
          "reasoning",
          "compute",
          "value"
        ]
      }
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_mode",
        "allowed_participant_types",
        "authorization_required",
        "anonymous_access_allowed",
        "allowed_access_scopes",
        "default_access_scopes"
      ],
      "properties": {
        "admission_mode": {
          "type": "string",
          "enum": [
            "invite-only",
            "allowlist",
            "policy-evaluated",
            "open-with-controls"
          ]
        },
        "allowed_participant_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "human",
              "agent",
              "organization",
              "service"
            ]
          }
        },
        "authorization_required": {
          "type": "boolean"
        },
        "anonymous_access_allowed": {
          "type": "boolean"
        },
        "allowed_access_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/accessScope"
          }
        },
        "default_access_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/accessScope"
          }
        }
      }
    },
    "permeability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound",
        "outbound"
      ],
      "properties": {
        "inbound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin_trace_required",
            "authorization_receipt_required",
            "audit_required",
            "accepted_classifications",
            "rejected_classifications"
          ],
          "properties": {
            "origin_trace_required": {
              "type": "boolean"
            },
            "authorization_receipt_required": {
              "type": "boolean"
            },
            "audit_required": {
              "type": "boolean"
            },
            "accepted_classifications": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/resourceClassification"
              }
            },
            "rejected_classifications": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/resourceClassification"
              }
            }
          }
        },
        "outbound": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derivative_trace_required",
            "royalty_settlement_required",
            "revocation_propagation_required"
          ],
          "properties": {
            "derivative_trace_required": {
              "type": "boolean"
            },
            "royalty_settlement_required": {
              "type": "boolean"
            },
            "revocation_propagation_required": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "contribution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_resource_bytes",
        "allowed_content_modes",
        "required_digest_algorithms",
        "duplicate_handling",
        "quarantine_supported"
      ],
      "properties": {
        "max_resource_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_content_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "reference",
              "inline"
            ]
          }
        },
        "required_digest_algorithms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sha256",
              "sha384",
              "sha512"
            ]
          }
        },
        "duplicate_handling": {
          "type": "string",
          "enum": [
            "reject",
            "replace",
            "version"
          ]
        },
        "quarantine_supported": {
          "type": "boolean"
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "deletion_on_revocation",
        "tombstone_required"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ephemeral",
            "bounded",
            "persistent"
          ]
        },
        "max_retention_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "deletion_on_revocation": {
          "type": "boolean"
        },
        "tombstone_required": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "suspended",
        "retired"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reuse_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_reuse_scopes",
        "max_lease_seconds",
        "lease_renewal_allowed",
        "max_concurrent_leases_per_resource",
        "circulation_receipt_required",
        "derived_resource_return_required",
        "expired_lease_action"
      ],
      "properties": {
        "allowed_reuse_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "derive",
              "execute",
              "redistribute",
              "commercialize"
            ]
          }
        },
        "max_lease_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "lease_renewal_allowed": {
          "type": "boolean"
        },
        "max_concurrent_leases_per_resource": {
          "type": "integer",
          "minimum": 1
        },
        "circulation_receipt_required": {
          "type": "boolean"
        },
        "derived_resource_return_required": {
          "type": "boolean"
        },
        "expired_lease_action": {
          "type": "string",
          "enum": [
            "deny-use",
            "quarantine-output",
            "human-review-required"
          ]
        }
      }
    },
    "immune_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residual_assessment_required",
        "accepted_residual_classifications",
        "quarantine_classifications",
        "anomaly_evidence_required_for",
        "quarantine_release_mode",
        "revocation_propagation_required",
        "max_propagation_depth",
        "require_known_derivative_coverage",
        "dormant_reassessment_seconds",
        "exhausted_action"
      ],
      "properties": {
        "residual_assessment_required": {
          "type": "boolean"
        },
        "accepted_residual_classifications": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "recoverable",
              "dormant",
              "hazardous",
              "exhausted"
            ]
          }
        },
        "quarantine_classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hazardous"
            ]
          }
        },
        "anomaly_evidence_required_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hazardous"
            ]
          }
        },
        "quarantine_release_mode": {
          "enum": [
            "human-review-only",
            "reassessment-and-review",
            "never"
          ]
        },
        "revocation_propagation_required": {
          "type": "boolean"
        },
        "max_propagation_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "require_known_derivative_coverage": {
          "type": "boolean"
        },
        "dormant_reassessment_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "exhausted_action": {
          "enum": [
            "tombstone",
            "delete-after-tombstone",
            "retain-evidence-only"
          ]
        }
      }
    }
  },
  "$defs": {
    "accessScope": {
      "type": "string",
      "enum": [
        "discover",
        "read",
        "contribute",
        "derive",
        "execute",
        "redistribute",
        "commercialize",
        "administer"
      ]
    },
    "resourceClassification": {
      "type": "string",
      "enum": [
        "verified",
        "provisional",
        "recoverable",
        "dormant",
        "hazardous",
        "private",
        "revoked",
        "exhausted"
      ]
    }
  }
}
