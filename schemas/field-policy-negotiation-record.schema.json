{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kazene:agentic-shared-field-protocol:field-policy-negotiation-record:0.5.0",
  "title": "Field Policy Negotiation Record",
  "description": "Records the negotiated intersection of source, target, and federation policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "negotiation_id",
    "federation_id",
    "source_admission_id",
    "target_admission_id",
    "source_field_id",
    "target_field_id",
    "requested_resource_domain",
    "requested_scopes",
    "policy_inputs",
    "resolved_terms",
    "unresolved_conflicts",
    "decision",
    "policy_digest",
    "negotiated_at",
    "expires_at",
    "issued_by"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "field-policy-negotiation-record"
    },
    "negotiation_id": {
      "type": "string",
      "pattern": "^policy-negotiation:[a-z0-9](?:[a-z0-9._-]{1,160}[a-z0-9])?$"
    },
    "federation_id": {
      "type": "string",
      "pattern": "^federation:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "source_admission_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "target_admission_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "source_field_id": {
      "type": "string",
      "pattern": "^field:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "target_field_id": {
      "type": "string",
      "pattern": "^field:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "requested_resource_domain": {
      "type": "string",
      "enum": [
        "knowledge",
        "memory",
        "reasoning",
        "compute",
        "value"
      ]
    },
    "requested_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read",
          "derive",
          "execute",
          "redistribute",
          "commercialize"
        ]
      }
    },
    "policy_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_policy_ref",
        "target_policy_ref",
        "federation_policy_ref"
      ],
      "properties": {
        "source_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "target_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "federation_policy_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "resolved_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_classifications",
        "max_lease_seconds",
        "retention_seconds",
        "audit_required",
        "derivative_trace_required",
        "royalty_settlement_required",
        "revocation_propagation_required",
        "target_reassessment_required",
        "royalty_policy_ref"
      ],
      "properties": {
        "accepted_classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "verified",
              "provisional",
              "recoverable",
              "dormant",
              "hazardous",
              "private",
              "revoked",
              "exhausted"
            ]
          }
        },
        "max_lease_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "audit_required": {
          "type": "boolean"
        },
        "derivative_trace_required": {
          "type": "boolean"
        },
        "royalty_settlement_required": {
          "type": "boolean"
        },
        "revocation_propagation_required": {
          "type": "boolean"
        },
        "target_reassessment_required": {
          "type": "boolean"
        },
        "royalty_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "unresolved_conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "agreed",
        "denied",
        "human-review-required"
      ]
    },
    "policy_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "negotiated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    }
  }
}
