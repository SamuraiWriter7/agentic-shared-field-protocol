{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kazene:agentic-shared-field-protocol:shared-resource-envelope:0.2.0",
  "title": "Shared Resource Envelope",
  "description": "Carries a proposed resource and its provenance, content reference, and rights metadata to a shared-field boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "envelope_id",
    "field_id",
    "contributor_binding_id",
    "resource_id",
    "resource_domain",
    "resource_kind",
    "proposed_classification",
    "origin",
    "content",
    "rights",
    "created_at",
    "lifecycle_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_type": {
      "const": "shared-resource-envelope"
    },
    "envelope_id": {
      "type": "string",
      "pattern": "^envelope:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "field_id": {
      "type": "string",
      "pattern": "^field:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "contributor_binding_id": {
      "type": "string",
      "pattern": "^binding:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^resource:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "resource_domain": {
      "type": "string",
      "enum": [
        "knowledge",
        "memory",
        "reasoning",
        "compute",
        "value"
      ]
    },
    "resource_kind": {
      "type": "string",
      "enum": [
        "knowledge-fragment",
        "memory-residue",
        "reasoning-artifact",
        "compute-offer",
        "value-claim"
      ]
    },
    "proposed_classification": {
      "$ref": "#/$defs/resourceClassification"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "origin_trace_id",
        "produced_by",
        "produced_at",
        "derivative_of"
      ],
      "properties": {
        "origin_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "origin_trace_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "produced_by": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "derivative_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "media_type",
        "content_ref",
        "digest",
        "size_bytes"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "reference",
            "inline"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "content_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256",
                "sha384",
                "sha512"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64,128}$"
            }
          }
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "encoding": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_scopes",
        "revocable",
        "royalty_policy_ref"
      ],
      "properties": {
        "permitted_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "derive",
              "execute",
              "redistribute",
              "commercialize"
            ]
          }
        },
        "revocable": {
          "type": "boolean"
        },
        "royalty_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "withdrawn",
        "expired",
        "revoked"
      ]
    }
  },
  "$defs": {
    "resourceClassification": {
      "type": "string",
      "enum": [
        "verified",
        "provisional",
        "recoverable",
        "dormant",
        "hazardous",
        "private",
        "revoked",
        "exhausted"
      ]
    }
  }
}
