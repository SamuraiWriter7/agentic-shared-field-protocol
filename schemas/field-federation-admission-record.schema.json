{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kazene:agentic-shared-field-protocol:field-federation-admission-record:0.5.0",
  "title": "Field Federation Admission Record",
  "description": "Admits, denies, or suspends a shared field within a federation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "admission_id",
    "federation_id",
    "field_id",
    "applicant_steward_id",
    "requested_resource_domains",
    "requested_scopes",
    "compatibility_checks",
    "approvals",
    "decision",
    "granted_resource_domains",
    "granted_scopes",
    "trust_level",
    "valid_from",
    "issued_by",
    "issued_at",
    "reason",
    "lifecycle_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "field-federation-admission-record"
    },
    "admission_id": {
      "type": "string",
      "pattern": "^federation-admission:[a-z0-9](?:[a-z0-9._-]{1,160}[a-z0-9])?$"
    },
    "federation_id": {
      "type": "string",
      "pattern": "^federation:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "field_id": {
      "type": "string",
      "pattern": "^field:[a-z0-9](?:[a-z0-9._-]{1,126}[a-z0-9])?$"
    },
    "applicant_steward_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "requested_resource_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "knowledge",
          "memory",
          "reasoning",
          "compute",
          "value"
        ]
      }
    },
    "requested_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read",
          "derive",
          "execute",
          "redistribute",
          "commercialize"
        ]
      }
    },
    "compatibility_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_compatibility",
        "trace_continuity",
        "authorization_continuity",
        "immune_continuity",
        "royalty_compatibility"
      ],
      "properties": {
        "schema_compatibility": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review"
          ]
        },
        "trace_continuity": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review"
          ]
        },
        "authorization_continuity": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review"
          ]
        },
        "immune_continuity": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review"
          ]
        },
        "royalty_compatibility": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review"
          ]
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approver_id",
          "decision",
          "decided_at"
        ],
        "properties": {
          "approver_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "admitted",
        "denied",
        "human-review-required",
        "suspended"
      ]
    },
    "granted_resource_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "knowledge",
          "memory",
          "reasoning",
          "compute",
          "value"
        ]
      }
    },
    "granted_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read",
          "derive",
          "execute",
          "redistribute",
          "commercialize"
        ]
      }
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "revoked",
        "expired"
      ]
    }
  }
}
