{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kazene:agentic-shared-field-protocol:field-circulation-receipt:0.5.0",
  "title": "Field Circulation Receipt",
  "description": "Closes a field-resource lease with use, return, trace, and obligation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "circulation_receipt_id",
    "lease_id",
    "reuse_request_id",
    "reuse_authorization_id",
    "field_id",
    "field_resource_id",
    "lessee_binding_id",
    "usage",
    "return_records",
    "obligations",
    "completed_at",
    "issued_by",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "record_type": {
      "const": "field-circulation-receipt"
    },
    "circulation_receipt_id": {
      "type": "string",
      "pattern": "^circulation-receipt:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "reuse_request_id": {
      "type": "string",
      "pattern": "^reuse-request:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "reuse_authorization_id": {
      "type": "string",
      "pattern": "^reuse-authz:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "field_id": {
      "type": "string",
      "pattern": "^field:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "field_resource_id": {
      "type": "string",
      "pattern": "^field-resource:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "lessee_binding_id": {
      "type": "string",
      "pattern": "^binding:[a-z0-9][a-z0-9._:-]{2,199}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at",
        "ended_at",
        "actual_scopes",
        "bytes_read"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "expired"
          ]
        },
        "execution_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "actual_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "derive",
              "execute",
              "redistribute",
              "commercialize"
            ]
          }
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "return_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "return_role",
          "envelope_id",
          "contribution_request_id",
          "return_status"
        ],
        "properties": {
          "return_role": {
            "type": "string",
            "enum": [
              "derivative",
              "residual",
              "failure-evidence"
            ]
          },
          "envelope_id": {
            "type": "string",
            "pattern": "^envelope:[a-z0-9][a-z0-9._:-]{2,199}$"
          },
          "contribution_request_id": {
            "type": "string",
            "pattern": "^contribution-request:[a-z0-9][a-z0-9._:-]{2,199}$"
          },
          "contribution_receipt_id": {
            "type": "string",
            "pattern": "^contribution-receipt:[a-z0-9][a-z0-9._:-]{2,199}$"
          },
          "return_status": {
            "type": "string",
            "enum": [
              "submitted",
              "admitted",
              "rejected",
              "quarantined",
              "pending-human-review"
            ]
          }
        }
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivative_trace_ids",
        "royalty_status",
        "revocation_acknowledged",
        "lease_closed"
      ],
      "properties": {
        "derivative_trace_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "royalty_status": {
          "type": "string",
          "enum": [
            "not-required",
            "pending",
            "settled",
            "failed"
          ]
        },
        "royalty_settlement_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "revocation_acknowledged": {
          "type": "boolean"
        },
        "lease_closed": {
          "type": "boolean"
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
